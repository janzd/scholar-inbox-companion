{
  "manifest_version": 3,
  "name": "Scholar Inbox Companion",
  "version": "0.3.0",
  "description": "Save papers from arXiv, CVF, OpenReview and other paper pages or PDFs to your Scholar Inbox collections.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.scholar-inbox.com/*",
    "https://arxiv.org/*"
  ],
  "action": {
    "default_title": "Save to Scholar Inbox",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
